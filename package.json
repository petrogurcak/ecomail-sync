{
  "name": "ecomail-sync",
  "version": "1.0.0",
  "description": "Tool for syncing Ecomail campaigns to markdown knowledge base",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "sync": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
